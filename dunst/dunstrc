[global]
    monitor = 0
    width = (0, 500)
    height = (0, 250)
    origin = top-right
    offset = 10x10
    notification_limit = 5o
    font = Jetbrains Mono Nerd Font
    frame_width = 1
    corner_radius = 2
    gap_size = 8

    markup = full
    format = "<b>%s</b>\n%b"
    padding = 8
    horizontal_padding = 12 

    sort = id	

    # Pywal colors
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#000000"


    [urgency_low]
    timeout = 3

    [urgency_normal]
    timeout = 3
    
    [urgency_critical]
    timeout = 5
